{
  "name": "baltimore-medtech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev",
    "build:field-atlas": "node scripts/build-medical-science-field-atlas.mjs",
    "build:links": "node scripts/validate-link-inventory.mjs --write assets/data/link-inventory.json",
    "test:field-atlas": "node scripts/validate-medical-science-field-atlas.mjs",
    "test:codes": "node scripts/validate-clinical-code-systems.mjs",
    "test:semantics": "node scripts/validate-clinical-semantic-systems.mjs",
    "test:strategy": "node scripts/validate-medtech-strategy-metrics.mjs",
    "test:distortions": "node scripts/validate-need-availability-distortions.mjs",
    "test:datasets": "node scripts/validate-dataset-workbook.mjs",
    "test:links": "node scripts/validate-link-inventory.mjs",
    "test:events": "node --test scripts/medical-event-images.test.mjs scripts/worker-org-events.test.mjs scripts/site-brand.test.mjs scripts/site-seo.test.mjs scripts/map-style.test.mjs",
    "test:data": "npm run test:field-atlas && npm run test:codes && npm run test:semantics && npm run test:strategy && npm run test:distortions && npm run test:datasets && npm run test:links && npm run test:events && npm run test:ecosystem",
    "build": "npm run build:ecosystem && npm run build:field-atlas && npm run build:links && npm run test:data && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:dry-run": "wrangler deploy --env=\"\" --dry-run",
    "test:selenium": "scripts/run-selenium-regression.sh",
    "test:clickthrough": "python3 scripts/selenium-clickthrough-smoke.py",
    "sync:ecosystem": "node scripts/sync-ecosystem.mjs",
    "build:ecosystem": "node scripts/build-ecosystem.mjs",
    "test:ecosystem": "node --test scripts/ecosystem.test.mjs scripts/portal-ecosystem.test.mjs scripts/ecosystem-physics.test.mjs",
    "build:lifetech": "SITE_BRAND=lifetech vite build",
    "deploy:lifetech": "wrangler deploy --env lifetech",
    "sync:portal-ecosystem": "node scripts/sync-portal-ecosystem.mjs"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^24.10.0",
    "@playwright/test": "^1.63.0",
    "vite": "^7.2.4",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "lucide": "^1.47.0",
    "maplibre-gl": "^5.24.0",
    "three": "^0.186.1"
  }
}
