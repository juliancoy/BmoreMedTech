{
  "name": "baltimore-medtech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:index": "node scripts/build-medtech-index.mjs",
    "test:index": "node scripts/validate-medtech-index.mjs",
    "test:codes": "node scripts/validate-clinical-code-systems.mjs",
    "test:semantics": "node scripts/validate-clinical-semantic-systems.mjs",
    "test:strategy": "node scripts/validate-medtech-strategy-metrics.mjs",
    "test:distortions": "node scripts/validate-need-availability-distortions.mjs",
    "test:data": "npm run test:index && npm run test:codes && npm run test:semantics && npm run test:strategy && npm run test:distortions",
    "build": "npm run build:index && npm run test:data && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "test:selenium": "scripts/run-selenium-regression.sh"
  },
  "devDependencies": {
    "vite": "^7.2.4",
    "wrangler": "^4.128.0"
  }
}
