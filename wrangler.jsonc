{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baltimore-medtech",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "medtech.social",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SITE_BRAND": "medtech"
  },
  "env": {
    "lifetech": {
      "name": "lifetech",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "lifetech.fyi",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "dist-lifetech",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": {
        "SITE_BRAND": "lifetech"
      },
      "services": [{ "binding": "DEV_ASSETS", "service": "codecollective-site-preview" }]
    }
  }
}
